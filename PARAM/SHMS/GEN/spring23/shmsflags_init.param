
; The pdelta_offset,ptheta_offset,pphi_offset effect the
; reconstructed target quantities. 
; For transport x is in the dispersive direction with + down
;               y is in the horizontal + towards small angles.
;               z is along the central optics axis.
; In transport coordinates phi = hyptar = dy/dz and theta = hxptar = dx/dz 
;    but for unknown reasons the yp offset is named  htheta_offset
;    and  the xp offset is named  hphi_offset
; Do not to change these values, since these are the zero order
;  CMOP matrix elements. If you do change then your shms sieve
;  plots will be screwed up.

; do not change pdelta_offset from zero, use ppcentral_offset
pdelta_offset = 0.0;   (%)   hdelta_tar = hdelta_tar + hdelta_offset 


; relative offsets 
;ptheta_offset = -2.81e-4 ; (rad) determined from thp_calc(Eb, the, k)-thp_meas for run 16962
;ptheta_offset = -2.0e-4 ; pyp_tar = pyp_tar + ptheta_offset
;ptheta_offset = 0.
pphi_offset   = 0.0 ; (rad) pxp_tar = pxp_tar + pphi_offset 


; The following offsets are applied to the central kinematic variables
;      ptheta_lab=htheta_lab + pthetacentral_offset/degree 

;pthetacentral_offset = 0.0
;p_oopcentral_offset = 0.
;p_oopcentral_offset = 0.0008   ; to align Pmy


; May 17, 2023: using W offset from run 16036 / 16962 
; ppcentral = ppcentral * ( 1. + ppcentral_offset / 100. )  = 0.9979
;ppcentral_offset = -0.21
;ppcentral_offset = 0.

;; The following offsets are finalized based on G. Huber and R. Trotta Study (Fall 2023)
;; Trying Kaon-LT offsets: added by Gema V. 01-14-2025

;; SHMS Centeral Momentum (P) Offset (All Kaon-LT Data)

;ppcentral_offset = -0.200

;; SHMS Central Angle (Theta) Offset (All Kaon-LT Data)

;pthetacentral_offset = 0.0011

;; SHMS Out-of-Plane (Phi) Offset (All Kaon-LT Data)

;p_oopcentral_offset = -0.00011

;;;;;;;;;;;;;;;;;;;;;;;;;;; (centroid_alignment documentation follow up)
;ppcentral_offset = 0.0 ; (Using second method of offset calculation 04/28/2025)

;ppcentral_offset = 0.3793 ; (Offset obtained from momentum correction) applied on 05/13/2025

ppcentral_offset = 0.4168;  (Obtained from Kf correction)

;ppcentral_offset = -0.287123;  (Obtained from additional Kf correction after additional yptar offset to the electron arm)
;ppcentral_offset = 0.3974;  (Obtained from additional Kf correction after additional yptar offset to the electron arm for -8 run)

p_oopcentral_offset = 0.0
pthetacentral_offset = 0.0 ;(Obtained from difference of calculated and measured values of HMS central angle)


ptheta_offset = -0.001889; (-0.003489 +/-0.0016)  ;   (For delta -8 run)  (rad) determined from thp_calc(Eb, the, k)-thp_meas for heep runs from -8 to +4 delta
;ptheta_offset = 0.01; (e_yptar shift check) (For -8 Run)
;ptheta_offset = -0.001235   ;(-0.003635 -(-0.0024))   ;   (For delta -4 run)
;ptheta_offset = -0.001642   ; (-0.004442 -(-0.0028))   ;  (For delta 0 run)
;ptheta_offset = -0.001121  ; (-0.005121 -(-0.004))   ;  (For delta +4 run)
